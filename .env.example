# Copy to .env for Docker Compose, then fill the real SQL Server settings.
# For Waitress/NSSM, set process/service environment variables or use configs.ini.
# The Python application does not automatically load .env files.
FLASK_SECRET_KEY=
# Example: tcp:sql.example.test,1433 or sql.example.test\SQLEXPRESS
CDR_DOMAIN=
DB_USER=
# In Compose .env files use single quotes around values containing $ or #.
DB_PASSWORD=
DB_VL_DATA=
DB_DPI=
DB_HIV_AD=
DB_TB_DATA=
DB_DICT=
DB_USERS=
DB_REPORT_DATA=

# Optional application settings (set them when using the corresponding feature).
SCHEMA_CDR=
CLERK_WEBHOOK_SECRET_KEY=
CLERK_SECRET_KEY=
CLERK_API_URL=
CLERK_JWTS_URL=
CLERK_ISSUER=
CLERK_PUBLIC_KEY=
CLERK_AUTHORIZED_PARTIES=
REPORT_DATA_HOST=
REPORT_DATA_USER=
REPORT_DATA_PASSWORD=
